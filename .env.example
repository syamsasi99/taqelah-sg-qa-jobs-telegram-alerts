# Copy to .env and fill in. .env is gitignored - never commit real values.
#   cp .env.example .env

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Target chat. Group IDs are negative, e.g. -1001234567890
# Use your STAGING group here for local runs, never production.
CHAT_ID=

# RapidAPI key for jsearch.p.rapidapi.com
RAPIDAPI_KEY=
